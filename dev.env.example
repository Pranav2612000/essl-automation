# Template for dev.env — the development configuration loaded by
#
#   python3 server.py --dev
#
# Copy it and generate your own token:
#
#   cp dev.env.example dev.env
#   python3 -c "import secrets; print('ZK_AUTH_TOKEN=' + secrets.token_urlsafe(24))" >> dev.env
#
# dev.env itself is gitignored: it holds a working operator token, and a token
# committed to a repo is a token everyone has. Real environment variables still
# override anything set here, so `ZK_PORT=9000 python3 server.py --dev` works.
# See .env.example for every setting and its default.

# ---------------------------------------------------------------------------
# Development defaults — no cloud account and no device required
# ---------------------------------------------------------------------------

# Required: the terminal reports naive local time, so we need its IANA zone.
ZK_DEVICE_TZ=Asia/Kolkata

# Dry run. Punches are stored in SQLite and logged, nothing is forwarded, so no
# Infino database or API key is needed. Switch to "infino" (and fill in the
# block below) only when you want to exercise real delivery.
ZK_SINKS=log

# 0.0.0.0 so a terminal on the LAN can actually dial in during development.
# Set 127.0.0.1 if you are only replaying requests with curl.
ZK_PORT=8081
ZK_BIND=0.0.0.0

# Keep dev data out of the production database file. data/ is gitignored.
ZK_DB_PATH=data/dev-attendance.db

# Who each user ID belongs to, and their Slack / GitHub accounts. Left empty so
# a fresh checkout starts without one. To switch it on:
#     cp directory.example.json directory.json   # then edit it
#     ZK_DIRECTORY_FILE=directory.json
# Populate it from the device itself — /users/sync, then /users.
ZK_DIRECTORY_FILE=

# Verbose logs to stdout; see the raw request bodies the terminal sends.
ZK_LOG_LEVEL=DEBUG
ZK_LOG_FILE=
ZK_REDACT_PINS=0

# Enables /raw and /reboot for firmware poking. Still behind ZK_AUTH_TOKEN.
ZK_DEBUG_ENDPOINTS=1

# Fail fast instead of retrying for a quarter of an hour while you iterate.
ZK_MAX_ATTEMPTS=3
ZK_RETRY_BASE_SECS=2
ZK_RETRY_CAP_SECS=30
ZK_WORKER_POLL_SECS=1

# Accept any serial that checks in, and don't nag about a quiet device.
ZK_ALLOWED_SERIALS=
ZK_SILENCE_SECS=3600

# Operator token for /status, /punches, /open, ... At least 16 characters.
# Generate your own; do not reuse this placeholder, and never reuse a
# production token here.
ZK_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Only needed if you set ZK_SINKS=infino above — use a scratch database, never
# the production one.
# ---------------------------------------------------------------------------
ZK_INFINO_URL=https://api.platform.infino.ws
ZK_INFINO_DATABASE=
ZK_INFINO_TABLE=attendance
ZK_INFINO_API_KEY=
ZK_INFINO_TIMEOUT=15
ZK_INFINO_BOOTSTRAP=1
