# Copy to .env and fill in your own values. .env is gitignored.
# These scripts read plain environment variables, so either export them
# yourself or use a loader such as `set -a; source .env; set +a`.

# Shared secret required by the push server's control endpoints
# (/open, /hold, /raw, /reboot, ...). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ZK_AUTH_TOKEN=

# Device settings used by pull_test.py
ZK_DEVICE_IP=192.168.1.100
ZK_DEVICE_PORT=4370
# The Comm Key configured on the device (Menu -> Comm -> Security).
ZK_COMM_KEY=0
