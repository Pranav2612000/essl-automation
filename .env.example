# Copy to .env and fill in your own values. .env is gitignored.
# These scripts read plain environment variables, so either export them
# yourself or use a loader such as `set -a; source .env; set +a`.
#
# server.py can also read a file like this one directly:
#   python3 server.py --env-file .env
#   python3 server.py --dev            # loads ./dev.env, see dev.env.example

# ---------------------------------------------------------------------------
# server.py — the production push server
# ---------------------------------------------------------------------------

# Shared secret required by the operator endpoints (/status, /punches, /open,
# /hold, ...). At least 16 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ZK_AUTH_TOKEN=

# REQUIRED. The terminal reports naive local time with no offset, so we need
# its IANA zone to store an unambiguous instant and to define "today".
ZK_DEVICE_TZ=Asia/Kolkata

# Listen address. The device dials in, so 0.0.0.0 by default; narrow it if you
# know which interface the device uses. A CLI argument overrides ZK_PORT.
ZK_PORT=8081
ZK_BIND=0.0.0.0


# Identity mapping: device user ID -> name, Slack user ID, GitHub login. Built
# by hand from the /users dump; see directory.example.json. Without it an
# arrival is logged by user ID only. A missing or malformed file stops startup,
# so a typo here is caught by --check-config rather than at 9am.
ZK_DIRECTORY_FILE=

# Logging. ZK_LOG_FILE is optional and rotates at 16MB x 5.
ZK_LOG_LEVEL=INFO
ZK_LOG_FILE=
# Replace employee user IDs in logs and API output with a short hash.
ZK_REDACT_PINS=0

# Where punches are forwarded: comma-separated. Sinks differ in what they
# carry, not just where they send it:
#   log             one row per punch, to the log     (dry run)
#   infino          one row per punch, to ZK_INFINO_TABLE
#   log_arrivals    one row per arrival, to the log   (dry run)
#   infino_arrivals one row per arrival, to ZK_INFINO_ARRIVALS_TABLE
#   log_slack       render the good-morning DM and print it (dry run)
#   slack           SEND the good-morning DM to a real person
# An arrival row carries the person's name, Slack and GitHub from
# ZK_DIRECTORY_FILE; both Infino sinks share one database and key.
ZK_SINKS=infino,infino_arrivals

# Infino Cloud (https://platform.infino.ws). Punches are appended as rows to
# ZK_INFINO_TABLE; the database and table are created on startup if missing.
# ZK_INFINO_URL may also carry the database as its last path segment, matching
# the SDK connect string in Infino's docs:
#   ZK_INFINO_URL=https://api.platform.infino.ws/my-app
ZK_INFINO_URL=https://api.platform.infino.ws
ZK_INFINO_DATABASE=
ZK_INFINO_TABLE=attendance
# Arrivals land in their own table: a different grain (one row per arrival,
# not per punch) and different columns. Must not equal ZK_INFINO_TABLE.
ZK_INFINO_ARRIVALS_TABLE=arrivals
# The terminal's roster, captured by /users/sync. Append-only: a re-sync adds
# rows and the newest synced_at per person wins.
ZK_INFINO_USERS_TABLE=device_users
# Starts with "inf_". INFINO_API_KEY is also accepted, since Infino's own SDKs
# read that name.
ZK_INFINO_API_KEY=
ZK_INFINO_TIMEOUT=15
# Create the database and table automatically. Set to 0 if they are managed
# elsewhere and this server's key should not create anything.
ZK_INFINO_BOOTSTRAP=1
# Append batching. Infino caps a request body at 5 MiB; these only bind when
# draining a backlog, since a punch row is a few hundred bytes.
ZK_INFINO_BATCH_ROWS=500
ZK_INFINO_BATCH_BYTES=3145728

# Retry policy for failed deliveries (exponential backoff with jitter, then
# dead-letter). Retryable = network errors, timeouts, 408, 429, 5xx; a
# server-supplied Retry-After (Infino sends one on its cold-start 503) wins.
ZK_MAX_ATTEMPTS=12
ZK_RETRY_BASE_SECS=5
ZK_RETRY_CAP_SECS=900
ZK_WORKER_POLL_SECS=2

# Hardening. An empty allowlist accepts any serial that checks in.
ZK_MAX_BODY_BYTES=4194304
ZK_ALLOWED_SERIALS=
# Enables /raw and /reboot. Leave off in production.
ZK_DEBUG_ENDPOINTS=0
# /healthz reports "degraded" after this many seconds without device contact.
ZK_SILENCE_SECS=300

# ---------------------------------------------------------------------------
# Slack good-morning DM. Only used when ZK_SINKS includes 'slack'; use
# 'log_slack' to iterate on the wording without messaging anyone.
# ---------------------------------------------------------------------------
# Bot token from a Slack app with the chat:write bot scope. Starts
# with xoxb-. A user token (xoxp-) would post as a person, not the app.
ZK_SLACK_BOT_TOKEN=
# Pilot gate: comma-separated DEVICE user IDs (the directory keys) that may be
# DMed. EMPTY MEANS EVERYONE — start with two or three volunteers.
ZK_SLACK_ALLOW=
ZK_SLACK_TIMEOUT=10

# ---------------------------------------------------------------------------
# GitHub — "pull requests waiting on your review" in the good-morning DM.
# Omit the token and the section is left out entirely; the greeting still goes.
# ---------------------------------------------------------------------------
# A personal access token that can read pull requests in the repos you care
# about (classic: repo; fine-grained: Pull requests -> Read-only). A GitHub App
# would be better — per-org install, rotating credentials — but App auth signs
# a JWT with RS256, which the standard library cannot do. See ROADMAP M6.1.
ZK_GITHUB_TOKEN=
# Optional: restrict the search to one organisation.
ZK_GITHUB_ORG=
# Most PRs to list before the message gets long.
ZK_GITHUB_MAX_ITEMS=5
# Short on purpose: this runs on the device's request thread, so every second
# here delays the terminal's acknowledgement of the punch.
ZK_GITHUB_TIMEOUT=6

# ---------------------------------------------------------------------------
# pull_test.py — direct pyzk pull, exploratory only
# ---------------------------------------------------------------------------
ZK_DEVICE_IP=192.168.1.100
ZK_DEVICE_PORT=4370
# The Comm Key configured on the device (Menu -> Comm -> Security).
ZK_COMM_KEY=0
