# Copy to .env and fill in your own values. .env is gitignored.
# These scripts read plain environment variables, so either export them
# yourself or use a loader such as `set -a; source .env; set +a`.

# ---------------------------------------------------------------------------
# server.py — the production push server
# ---------------------------------------------------------------------------

# Shared secret required by the operator endpoints (/status, /punches, /open,
# /hold, ...). At least 16 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ZK_AUTH_TOKEN=

# REQUIRED. The terminal reports naive local time with no offset, so we need
# its IANA zone to store an unambiguous instant and to define "today".
ZK_DEVICE_TZ=Asia/Kolkata

# Listen address. The device dials in, so 0.0.0.0 by default; narrow it if you
# know which interface the device uses. A CLI argument overrides ZK_PORT.
ZK_PORT=8081
ZK_BIND=0.0.0.0

# Where punches and the delivery outbox live.
ZK_DB_PATH=data/attendance.db

# Logging. ZK_LOG_FILE is optional and rotates at 16MB x 5.
ZK_LOG_LEVEL=INFO
ZK_LOG_FILE=
# Replace employee PINs in logs and API output with a short hash.
ZK_REDACT_PINS=0

# Where punches are forwarded: comma-separated, "infino" and/or "log".
# Use "log" alone for a dry run that stores punches without forwarding them.
ZK_SINKS=infino

# Infino Cloud (https://platform.infino.ws). Punches are appended as rows to
# ZK_INFINO_TABLE; the database and table are created on startup if missing.
# ZK_INFINO_URL may also carry the database as its last path segment, matching
# the SDK connect string in Infino's docs:
#   ZK_INFINO_URL=https://api.platform.infino.ws/my-app
ZK_INFINO_URL=https://api.platform.infino.ws
ZK_INFINO_DATABASE=
ZK_INFINO_TABLE=attendance
# Starts with "inf_". INFINO_API_KEY is also accepted, since Infino's own SDKs
# read that name.
ZK_INFINO_API_KEY=
ZK_INFINO_TIMEOUT=15
# Create the database and table automatically. Set to 0 if they are managed
# elsewhere and this server's key should not create anything.
ZK_INFINO_BOOTSTRAP=1
# Append batching. Infino caps a request body at 5 MiB; these only bind when
# draining a backlog, since a punch row is a few hundred bytes.
ZK_INFINO_BATCH_ROWS=500
ZK_INFINO_BATCH_BYTES=3145728

# Retry policy for failed deliveries (exponential backoff with jitter, then
# dead-letter). Retryable = network errors, timeouts, 408, 429, 5xx; a
# server-supplied Retry-After (Infino sends one on its cold-start 503) wins.
ZK_MAX_ATTEMPTS=12
ZK_RETRY_BASE_SECS=5
ZK_RETRY_CAP_SECS=900
ZK_WORKER_POLL_SECS=2

# Hardening. An empty allowlist accepts any serial that checks in.
ZK_MAX_BODY_BYTES=4194304
ZK_ALLOWED_SERIALS=
# Enables /raw and /reboot. Leave off in production.
ZK_DEBUG_ENDPOINTS=0
# /healthz reports "degraded" after this many seconds without device contact.
ZK_SILENCE_SECS=300

# ---------------------------------------------------------------------------
# pull_test.py — direct pyzk pull, exploratory only
# ---------------------------------------------------------------------------
ZK_DEVICE_IP=192.168.1.100
ZK_DEVICE_PORT=4370
# The Comm Key configured on the device (Menu -> Comm -> Security).
ZK_COMM_KEY=0
